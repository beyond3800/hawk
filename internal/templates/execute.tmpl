package console

import (
	"log"
	"os"

	engine "github.com/beyond3800/hawk/engine"
	hawk "github.com/beyond3800/hawk"
)

func Execute(app *engine.Hawk) {

	if len(os.Args) > 1 {

		if command, ok := commands[os.Args[1]]; ok {

			if err := command(); err != nil {
				log.Fatal(err)
			}

			return
		}
	}

	hawk.Execute(app)
}
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg: #0b0f14;
    --surface: #111820;
    --surface-light: #17212b;
    --border: #25313d;
    --text: #f3f6f8;
    --muted: #94a3b8;
    --accent: #f59e0b;
    --accent-dark: #d97706;
    --green: #22c55e;
}

body {
    min-height: 100vh;
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background:
        radial-gradient(circle at top,
            rgba(245, 158, 11, 0.12),
            transparent 35%),
        var(--bg);
    color: var(--text);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 20px;
}

.container {
    width: 100%;
    max-width: 960px;
}

.hero {
    text-align: center;
    padding: 48px 20px 36px;
}

.logo {
    width: 76px;
    height: 76px;
    margin: 0 auto 24px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg,
            var(--accent),
            var(--accent-dark));
    box-shadow: 0 15px 45px rgba(245, 158, 11, 0.2);
    font-size: 38px;
    font-weight: 800;
    color: #111;
}

.badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 13px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(17, 24, 32, 0.8);
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 20px;
}

.status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.6);
}

h1 {
    font-size: clamp(42px, 8vw, 72px);
    line-height: 1;
    letter-spacing: -3px;
    margin-bottom: 20px;
}

h1 span {
    color: var(--accent);
}

.subtitle {
    max-width: 620px;
    margin: 0 auto;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 20px;
}

.card {
    background: rgba(17, 24, 32, 0.85);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    transition:
        transform 0.2s ease,
        border-color 0.2s ease;
}

.card:hover {
    transform: translateY(-3px);
    border-color: rgba(245, 158, 11, 0.5);
}

.icon {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: var(--surface-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    color: var(--accent);
    font-size: 20px;
    font-weight: 700;
}

.card h2 {
    font-size: 17px;
    margin-bottom: 9px;
}

.card p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
}

.code-card {
    margin-top: 16px;
    padding: 24px;
    background: #080c10;
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
}

.code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.code-title {
    color: var(--muted);
    font-size: 13px;
}

.dots {
    display: flex;
    gap: 6px;
}

.dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border);
}

pre {
    overflow-x: auto;
    color: #dbe4ec;
    font-family:
        "Cascadia Code",
        "SFMono-Regular",
        Consolas,
        monospace;
    font-size: 14px;
    line-height: 1.8;
}

.keyword {
    color: #c084fc;
}

.function {
    color: #60a5fa;
}

.string {
    color: #86efac;
}

.comment {
    color: #64748b;
}

.footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 28px;
    padding: 22px 4px;
    color: var(--muted);
    font-size: 13px;
}

.footer strong {
    color: var(--text);
}

.links {
    display: flex;
    gap: 18px;
}

.links a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
}

.links a:hover {
    color: var(--accent);
}

@media (max-width: 720px) {
    .grid {
        grid-template-columns: 1fr;
    }

    .hero {
        padding-top: 30px;
    }

    .footer {
        flex-direction: column;
        text-align: center;
    }

    h1 {
        letter-spacing: -2px;
    }
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Hawk - A lightweight Go web API framework">
    <link rel="stylesheet" href="/css/index.css">
    <title>Hawk — Go API Framework</title>
</head>

<body>
    <main class="container">

        
        <section class="hero">

            <div class="logo">
                H
            </div>

            <div class="badge">
                <span class="status"></span>
                Hawk server is running
            </div>

            <h1>
                Welcome to <span>Hawk</span>
            </h1>

            <p class="subtitle">
                A lightweight and expressive Go framework for building
                fast, reliable, and scalable web APIs.
            </p>

        </section>

        <section class="grid">

            <article class="card">
                <div class="icon">⚡</div>

                <h2>Fast</h2>

                <p>
                    Built with Go to provide a lightweight foundation
                    for high-performance web applications and APIs.
                </p>
            </article>

            <article class="card">
                <div class="icon">◈</div>

                <h2>Simple</h2>

                <p>
                    Clean routing, middleware, request handling,
                    validation, database tools, and more.
                </p>
            </article>

            <article class="card">
                <div class="icon">⌘</div>

                <h2>Developer Friendly</h2>

                <p>
                    Use Hawk's CLI and framework tools to build your
                    application with less boilerplate.
                </p>
            </article>

        </section>

        <section class="code-card">

            <div class="code-header">

                <span class="code-title">
                    Your first Hawk route
                </span>

                <div class="dots">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </div>

            </div>

            <pre><code><span class="keyword">func</span> <span class="function">SetupRoutes</span>() *hawk.Hawk {
app := hawk.Default()

app.Get(<span class="string">"/hello"</span>, <span class="keyword">func</span>(c *hawk.Context) {
    c.JSON(<span class="string">200</span>, <span class="string">"Hello from Hawk"</span>)
})

<span class="keyword">return</span> app


}</code></pre>

            
        </section>

        <footer class="footer">

            <div>
                Powered by <strong>Hawk</strong> · Go Web Framework
            </div>

            <div class="links">
                <a href="#">Documentation</a>
                <a href="https://github.com/beyond3800/hawk">GitHub</a>
            </div>

        </footer>

    </main>
    

</body>

</html>